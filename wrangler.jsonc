{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobaken-co",
  "compatibility_date": "2024-04-01",
  "main": "server.tsx",
  // Static assets (CSS, generated client JS, manifest) are served
  // directly by Workers Assets. The Worker script handles everything
  // else — SSR, API routes, etc.
  "assets": {
    "directory": "./public"
  },
  // Blog post source files are imported as raw text (frontmatter parsed
  // and Markdown rendered at request time in blog/content.ts).
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
