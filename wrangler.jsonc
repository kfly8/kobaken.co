{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kobaken-co",
  // Not a secret — account IDs are visible in the dashboard URL. Pinning
  // it here means CI only needs CLOUDFLARE_API_TOKEN, not a second secret.
  "account_id": "e680616185a3b617a32987a6571991b7",
  // Workers Cache requires a recent compatibility date.
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "main": "server.tsx",
  // Static assets (CSS, generated client JS, manifest) are served
  // directly by Workers Assets. The Worker script handles everything
  // else — SSR, API routes, etc.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Deck HTML needs request-specific metadata; CSS, fonts and slide
    // fragments still go straight to Workers Assets.
    "run_worker_first": ["/slides/*/", "/slides/*/index.html"]
  },
  // Blog post source files are imported as raw text (frontmatter parsed
  // and Markdown rendered at request time in blog/content.ts).
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  // Lets the platform cache Worker-generated responses (namely the OGP
  // images at /blog|diary/:slug/og.png) based on their own Cache-Control
  // header — no caches.default match()/put() boilerplate needed.
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
